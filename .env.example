# ============================================================
# CodeGuardian — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only .env.example belongs in git.
# ============================================================

# LLM Provider: groq (free, default) | openai | anthropic
LLM_PROVIDER=groq

# --- Groq (FREE — recommended) ---
# Get your free key at: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (optional fallback) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional fallback) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- GitHub ---
# Create a Personal Access Token with "repo" scope:
# https://github.com/settings/tokens → Generate new token (classic) → check "repo"
GITHUB_TOKEN=your_github_personal_access_token_here

# Webhook secret — generate a random string and use the SAME value in GitHub webhook settings:
# python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# --- Server ---
HOST=0.0.0.0
PORT=8000

# Set to true only for local development (enables hot-reload — NEVER use in production)
DEV_MODE=false
